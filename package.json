{
  "name": "oia-5302-demo",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-with-api.mjs",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "build": "node scripts/pack-issue-inputs-zip.mjs && node scripts/pack-demo-audio.mjs && node scripts/generate-controlled-html.mjs && npx tsc -b && npx vite build",
    "verify:offline": "node scripts/verify-offline-build.mjs",
    "demo:offline": "npm run build && npm run verify:offline && node scripts/serve-offline-demo.mjs",
    "deploy:surge": "node scripts/deploy-surge-cloud.mjs https://oia-5302-demo.onrender.com oia-recruitment.uiscloud.cc",
    "deploy:surge:cloud": "node scripts/deploy-surge-cloud.mjs",
    "video:build": "node scripts/build-demo-video.mjs",
    "video:record": "node scripts/record-demo.mjs",
    "video:record-vo": "node scripts/align-by-transcript.mjs && node scripts/record-to-voiceover.mjs && node scripts/clean-voiceover.mjs && node scripts/mux-final.mjs",
    "video:mux": "node scripts/mux-natural.mjs",
    "video:sync": "node scripts/sync-segmented.mjs",
    "video:sync-uniform": "node scripts/sync-audio-video.mjs",
    "video:clean-audio": "node scripts/clean-voiceover.mjs",
    "pdf:narration": "node scripts/generate-narration-pdf.mjs",
    "pdf:handoff": "node scripts/generate-handoff-pdf.mjs",
    "demo:documents": "node scripts/generate-demo-documents.mjs",
    "demo:documents:publish": "npm run demo:documents && node scripts/sync-issue-inputs.mjs && node scripts/generate-controlled-html.mjs",
    "demo:monitor": "node scripts/offline-monitor.mjs",
    "progress:sync": "node scripts/sync-conversation-progress.mjs",
    "verify:azure": "node scripts/verify-azure-speech.mjs",
    "verify:azure:render": "node scripts/verify-azure-speech.mjs --url https://oia-5302-demo.onrender.com",
    "verify:openai-tts": "node scripts/verify-openai-tts.mjs",
    "verify:openai-tts:render": "node scripts/verify-openai-tts.mjs --url https://oia-5302-demo.onrender.com",
    "verify:heygen": "node scripts/verify-heygen.mjs",
    "verify:heygen:render": "node scripts/verify-heygen.mjs --url https://oia-5302-demo.onrender.com",
    "verify:liveavatar": "node scripts/verify-liveavatar.mjs",
    "verify:liveavatar:render": "node scripts/verify-liveavatar.mjs --url https://oia-5302-demo.onrender.com",
    "heygen:list-avatars": "node scripts/heygen-list-avatars.mjs",
    "heygen:probe-realtime": "node scripts/heygen-probe-realtime.mjs",
    "liveavatar:list-avatars": "node scripts/liveavatar-list-avatars.mjs",
    "pdf:narration:en": "node scripts/generate-narration-pdf.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "edge-tts-universal": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "docx": "^9.7.1",
    "hls.js": "^1.7.0",
    "livekit-client": "^2.21.0",
    "lucide-react": "^1.31.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "optionalDependencies": {
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0"
  }
}
