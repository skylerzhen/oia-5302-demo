# LLM + TTS provider: openai (recommended) | deepseek
LLM_PROVIDER=openai

# OpenAI — paste company key (LLM + TTS share this key)
OPENAI_API_KEY=
OPENAI_TTS_VOICE=shimmer
OPENAI_TTS_MODEL=tts-1
LLM_MODEL=gpt-4o
LLM_MODEL_FAST=gpt-4o-mini

# DeepSeek fallback (optional)
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# LLM_MODEL=deepseek-chat
# LLM_MODEL_FAST=deepseek-chat

LLM_API_PORT=8787

# Azure Speech — optional TTS viseme + ASR (overrides OpenAI TTS when set)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=uaenorth
# AZURE_SPEECH_VOICE_EN=en-US-JennyNeural

# Surge cloud demo build (see docs/demo-5302/cloud-demo-deploy.md)
# VITE_LLM_API_URL=https://oia-5302-demo.onrender.com
# Must match Render API_SECRET — required for LiveAvatar / LLM POST from Surge
# VITE_API_SECRET=
# API_SECRET=

# HeyGen digital human (optional — blocked if Avatar Realtime 404; prefer LiveAvatar below)
# Get API key: https://app.heygen.com/settings?nav=API
# List avatar looks: npm run heygen:list-avatars
# HEYGEN_API_KEY=
# HEYGEN_AVATAR_ID=

# LiveAvatar Lite — digital human with OpenAI TTS (recommended when HeyGen realtime 404)
# Sign up: https://app.liveavatar.com · docs/demo-5302/liveavatar-setup.md
# List avatars: npm run liveavatar:list-avatars
# LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=e9844e6d-847e-4964-a92b-7ecd066f69df
