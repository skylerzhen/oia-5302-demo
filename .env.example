# LLM + TTS provider: openai (recommended) | deepseek
LLM_PROVIDER=openai

# OpenAI — LLM + TTS (set OPENAI_API_KEY in llm.env for local dev)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_TTS_VOICE=shimmer
OPENAI_TTS_MODEL=tts-1
LLM_MODEL=gpt-4o
LLM_MODEL_FAST=gpt-4o-mini

LLM_API_PORT=8787

# Shared secret — required on Render; same value as VITE_API_SECRET for Surge builds
API_SECRET=your-random-secret-here
VITE_API_SECRET=your-random-secret-here
